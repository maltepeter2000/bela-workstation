#X msg 60 8070 a1 \$1;
#X floatatom 160 8046 6 0 31 0 - - -;
#X msg 160 8070 d1 \$1;
#X floatatom 260 8046 6 0 31 0 - - -;
#X msg 260 8070 bp1 \$1;
#X floatatom 360 8046 6 0 31 0 - - -;
#X msg 360 8070 sl1 \$1;
