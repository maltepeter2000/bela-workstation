#X floatatom 60 8100 6 0 31 0 - - -;
#X msg 60 8124 su1 \$1;
#X floatatom 160 8100 6 0 31 0 - - -;
#X msg 160 8124 r1 \$1;
#X text 82 8154 a1 d1 bp1 sl1 su1 r1: attack \, decay \, break point \, slope \, sustain \, release of DEG1 (DCO1) \, 0-31. Setting one makes env1 -1., f 64;
