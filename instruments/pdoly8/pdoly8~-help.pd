#X msg 160 8284 r2 \$1;
#X text 82 8314 a2 d2 bp2 sl2 su2 r2: the same for DEG2 (DCO2) \, env2 -1., f 64;
#X obj 460 8358 s \$0-pdoly8;
#X floatatom 60 8334 6 0 127 0 - - -;
#X msg 60 8358 vamp \$1;
#X text 82 8388 vamp (0): velocity to the level of each voice (both DCOs \, not on the Poly-800): 0 off \, 127 level = velocity., f 64;
#X obj 60 8434 cnv 10 10 10 empty empty Portamento 24 6 0 14 #1e3791 #000000 0;
#X text 82 8462 Not on the Poly-800., f 64;
#X obj 460 8506 s \$0-pdoly8;
#X floatatom 60 8482 6 0 127 0 - - -;
#X msg 60 8506 port \$1;
#X floatatom 160 8482 6 0 2 0 - - -;
#X msg 160 8506 pmod \$1;
#X text 82 8536 port (0): glide time 0-127 = off to 3 s. \; pmod (0): where a glide starts: 0 from the last note played \, 1 from the note this voice played before \, 2 from the last note only while another key is still held (legato glide). pmod is not a mono / poly switch., f 64;
#X obj 460 8644 s \$0-pdoly8;
#X floatatom 60 8620 6 0 1 0 - - -;
#X msg 60 8644 mono \$1;
#X floatatom 160 8620 6 0 1 0 - - -;
#X msg 160 8644 retr \$1;
#X text 82 8674 mono (0): 0 poly (4 voices) \, 1 mono: one voice \, the last key wins. \; retr (1): in mono \, 1: every key restarts the envelopes \, 0: legato \, only the first key of a phrase restarts them \, further keys (and going back to a held one) only change the pitch., f 64;
#X obj 60 8768 cnv 10 10 10 empty empty Additional\ settings 24 6 0 14 #1e3791 #000000 0;
#X obj 460 8820 s \$0-pdoly8;
#X floatatom 60 8796 6 0 12 0 - - -;
#X msg 60 8820 bnd \$1;
#X floatatom 160 8796 6 0 16 0 - - -;
#X msg 160 8820 ch1 \$1;
#X text 82 8850 bnd (2): bend range in semitones (original: up to 7). Pitch bend from a MIDI keyboard comes in through [bendin] at the top. \; ch1 (0): MIDI channel for p v ch lists \, 0 = any., f 64;
#X obj 460 8942 s \$0-pdoly8;
#X floatatom 60 8918 6 -6 6 0 - - -;
#X msg 60 8942 treb \$1;
#X floatatom 160 8918 6 -6 6 0 - - -;
#X msg 160 8942 bass \$1;
#X text 82 8972 treb \, bass (0): EQ -6..6 (76/77 \, measured: about 4 dB at 3 \, 10 dB at 6 \, shelves at 4.3 kHz and 115 Hz)., f 64;
#X obj 460 9032 s \$0-pdoly8;
#X floatatom 60 9008 6 0 127 0 - - -;
#X msg 60 9032 sprd \$1;
#X floatatom 160 9008 6 0 100 0 - - -;
#X msg 160 9032 mrph \$1;
#X text 82 9062 sprd (0): stereo spread of the 4 voices 0-127. \; mrph (25): smoothing time in ms of every continuous setting (timbre \, levels \, cutoff \, resonance \, FM \, ring \, drive \, noise \, DCO2 pitch \, detune \, vibrato \, EG depth ...) \, so MIDI CC steps become ramps. 0 = none., f 64;
#X obj 460 9170 s \$0-pdoly8;
#X floatatom 60 9146 6 0 1 0 - - -;
#X msg 60 9170 tone \$1;
#X floatatom 160 9146 6 0 1 0 - - -;
#X msg 160 9170 leak \$1;
#X text 82 9200 tone (1): 1: output stage measured on a Poly-800 (54 Hz high-pass \, VCF \, 1 pole at 5 kHz) \, 0: raw tone generators. \; leak (0): 1: released voices stay at -55 dB \, as on the original., f 64;
#X obj 460 9292 s \$0-pdoly8;
#X floatatom 60 9268 6 0 127 0 - - -;
#X msg 60 9292 drft \$1;
#X text 82 9322 drft (0): analogue drift (not on the Poly-800 \, whose pitch comes from a crystal and dividers) \, like the slop / vintage knob of newer Sequential instruments: every DCO of every voice wanders slowly and on its own (at 127 about +-3 cents \, peaks about 8) \, each note's envelopes run a little faster or slower (+-20 % \, DEG3 too) \, the MG rate wanders +-10 % and the cutoff +-0.2 octaves. 0 = exact., f 64;
#X text 82 9448 Credits: Modelled on the Korg Poly-800 service manual\; \; MSM5232\; scale ROM data as documented in MAME's \; msm5232.cpp with help by Claude, f 64;
