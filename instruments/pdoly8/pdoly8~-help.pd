#X msg 60 6630 l2t1 pitch;
#X msg 190 6630 l2t1 har1;
#X msg 320 6630 l3t1 cut;
#X text 82 6664 l3t1 \, l3a1 \, l3t2 \, l3a2: the same for LFO3., f 64;
#X obj 60 6714 cnv 10 10 10 empty empty Delay\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 6748 The digital delay of the Poly-800 II (71-75) \, measured: the echo is in phase on the left output and inverted on the right (a mono sum cancels it). A gate ends the echo train \, changing a value mutes the echo for a moment \, as on the original., f 64;
#X obj 460 6848 s \$0-pdoly8;
#X floatatom 60 6824 6 0 99 0 - - -;
#X msg 60 6848 dtim \$1;
#X floatatom 160 6824 6 0 15 0 - - -;
#X msg 160 6848 dfb \$1;
#X text 82 6878 dtim (30): 0-99 = 4.2 ms - 1.08 s (70: 216 ms). \; dfb (0): feedback 0-15 (15: -3.1 dB per echo)., f 64;
#X obj 460 6952 s \$0-pdoly8;
#X floatatom 60 6928 6 0 31 0 - - -;
#X msg 60 6952 dmf \$1;
#X floatatom 160 6928 6 0 31 0 - - -;
#X msg 160 6952 dmi \$1;
#X text 82 6982 dmf (0): mod rate 0-31 = 0.05-5 Hz. \; dmi (0): mod depth 0-31 (31: the time swings 1:5 \, about 10 dB less per 10 steps below)., f 64;
#X obj 460 7072 s \$0-pdoly8;
#X floatatom 60 7048 6 0 15 0 - - -;
#X msg 60 7072 dlev \$1;
#X obj 460 7102 s \$0-pdoly8;
#X msg 60 7102 delay flanger;
#X msg 190 7102 delay chorus1;
#X msg 320 7102 delay chorus2;
#X msg 60 7136 delay slap;
#X msg 190 7136 delay long;
#X msg 320 7136 delay off;
#X text 82 7170 dlev (0): echo level 0-15 \, 0 = off. \; Presets: flanger (4 ms \, slow sweep \, feedback) \, chorus1 (fast \, shallow) \, chorus2 (slow \, wider) \, slap (120 ms) \, long (0.5 s with repeats) \, off., f 64;
#X obj 60 7268 cnv 10 10 10 empty empty DEG1\ &\ DEG2\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 7302 Each voice's DCO1 and DCO2 have their own 6-stage DEG as on the Poly-800. Measured on a Poly-800 II: level 0-31 is about (L/31)^2 \, attack rises linearly (31: about 9 s) \, decay \, slope and release fall at a constant dB per second (31: about 18 s to -40 dB). env1 / env2 (Controls) morph through: 0 gate / 1 short pluck / 24 pluck / 48 piano / 72 long release / 92 swell / 108 pad / 127 long pad., f 64;
#X obj 460 7450 s \$0-pdoly8;
#X floatatom 60 7426 6 0 31 0 - - -;
#X msg 60 7450 a1 \$1;
#X floatatom 160 7426 6 0 31 0 - - -;
#X msg 160 7450 d1 \$1;
#X floatatom 260 7426 6 0 31 0 - - -;
#X msg 260 7450 bp1 \$1;
#X floatatom 360 7426 6 0 31 0 - - -;
#X msg 360 7450 sl1 \$1;
#X obj 460 7504 s \$0-pdoly8;
#X floatatom 60 7480 6 0 31 0 - - -;
#X msg 60 7504 su1 \$1;
#X floatatom 160 7480 6 0 31 0 - - -;
#X msg 160 7504 r1 \$1;
#X text 82 7534 a1 d1 bp1 sl1 su1 r1: attack \, decay \, break point \, slope \, sustain \, release of DEG1 (DCO1) \, 0-31. Setting one makes env1 -1., f 64;
#X obj 460 7624 s \$0-pdoly8;
#X floatatom 60 7600 6 0 31 0 - - -;
#X msg 60 7624 a2 \$1;
#X floatatom 160 7600 6 0 31 0 - - -;
#X msg 160 7624 d2 \$1;
#X floatatom 260 7600 6 0 31 0 - - -;
#X msg 260 7624 bp2 \$1;
#X floatatom 360 7600 6 0 31 0 - - -;
#X msg 360 7624 sl2 \$1;
#X obj 460 7678 s \$0-pdoly8;
#X floatatom 60 7654 6 0 31 0 - - -;
#X msg 60 7678 su2 \$1;
#X floatatom 160 7654 6 0 31 0 - - -;
#X msg 160 7678 r2 \$1;
#X text 82 7708 a2 d2 bp2 sl2 su2 r2: the same for DEG2 (DCO2) \, env2 -1., f 64;
#X obj 460 7766 s \$0-pdoly8;
#X floatatom 60 7742 6 0 127 0 - - -;
#X msg 60 7766 vamp \$1;
#X text 82 7796 vamp (0): velocity to the level of each voice (both DCOs \, not on the Poly-800): 0 off \, 127 level = velocity., f 64;
#X obj 60 7862 cnv 10 10 10 empty empty Portamento 24 6 0 14 #1e3791 #000000 0;
#X text 82 7896 Not on the Poly-800., f 64;
#X obj 460 7948 s \$0-pdoly8;
#X floatatom 60 7924 6 0 127 0 - - -;
#X msg 60 7948 port \$1;
#X floatatom 160 7924 6 0 2 0 - - -;
#X msg 160 7948 pmod \$1;
#X text 82 7978 port (0): glide time 0-127 = off to 3 s. \; pmod (0): where a glide starts: 0 from the last note played \, 1 from the note this voice played before \, 2 from the last note only while another key is still held (legato glide). pmod is not a mono / poly switch., f 64;
#X obj 460 8100 s \$0-pdoly8;
#X floatatom 60 8076 6 0 1 0 - - -;
#X msg 60 8100 mono \$1;
#X floatatom 160 8076 6 0 1 0 - - -;
#X msg 160 8100 retr \$1;
#X text 82 8130 mono (0): 0 poly (4 voices) \, 1 mono: one voice \, the last key wins. \; retr (1): in mono \, 1: every key restarts the envelopes \, 0: legato \, only the first key of a phrase restarts them \, further keys (and going back to a held one) only change the pitch., f 64;
#X obj 60 8244 cnv 10 10 10 empty empty Additional\ settings 24 6 0 14 #1e3791 #000000 0;
#X obj 460 8302 s \$0-pdoly8;
#X floatatom 60 8278 6 0 12 0 - - -;
#X msg 60 8302 bnd \$1;
#X floatatom 160 8278 6 0 16 0 - - -;
#X msg 160 8302 ch1 \$1;
#X text 82 8332 bnd (2): bend range in semitones (original: up to 7). Pitch bend from a MIDI keyboard comes in through [bendin] at the top. \; ch1 (0): MIDI channel for p v ch lists \, 0 = any., f 64;
#X obj 460 8438 s \$0-pdoly8;
#X floatatom 60 8414 6 -6 6 0 - - -;
#X msg 60 8438 treb \$1;
#X floatatom 160 8414 6 -6 6 0 - - -;
#X msg 160 8438 bass \$1;
#X text 82 8468 treb \, bass (0): EQ -6..6 (76/77 \, measured: about 4 dB at 3 \, 10 dB at 6 \, shelves at 4.3 kHz and 115 Hz)., f 64;
#X obj 460 8542 s \$0-pdoly8;
#X floatatom 60 8518 6 0 127 0 - - -;
#X msg 60 8542 sprd \$1;
#X floatatom 160 8518 6 0 100 0 - - -;
#X msg 160 8542 mrph \$1;
#X text 82 8572 sprd (0): stereo spread of the 4 voices 0-127. \; mrph (8): smoothing of har and lev changes in ms., f 64;
#X obj 460 8646 s \$0-pdoly8;
#X floatatom 60 8622 6 0 1 0 - - -;
#X msg 60 8646 tone \$1;
#X floatatom 160 8622 6 0 1 0 - - -;
#X msg 160 8646 leak \$1;
#X text 82 8676 tone (1): 1: output stage measured on a Poly-800 (54 Hz high-pass \, VCF \, 1 pole at 5 kHz) \, 0: raw tone generators. \; leak (0): 1: released voices stay at -55 dB \, as on the original., f 64;
#X obj 460 8782 s \$0-pdoly8;
#X floatatom 60 8758 6 0 127 0 - - -;
#X msg 60 8782 drft \$1;
#X text 82 8812 drft (0): analogue drift (not on the Poly-800 \, whose pitch comes from a crystal and dividers) \, like the slop / vintage knob of newer Sequential instruments: every DCO of every voice wanders slowly and on its own (at 127 about +-3 cents \, peaks about 8) \, each note's envelopes run a little faster or slower (+-20 % \, DEG3 too) \, the MG rate wanders +-10 % and the cutoff +-0.2 octaves. 0 = exact., f 64;
#X text 82 8958 Credits: Modelled on the Korg Poly-800 service manual\; \; MSM5232\; scale ROM data as documented in MAME's \; msm5232.cpp with help by Claude, f 64;
