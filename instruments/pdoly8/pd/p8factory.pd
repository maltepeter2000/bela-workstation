#N canvas 120 120 640 500 12;
#X text 20 10 p8factory: the 64 Poly-800 II factory programs \, read-only. A slot number 0-63 (0 = program 11 \, 7 = 18 \, 8 = 21 ... 63 = 88) sends that program as "dump pdoly8 ..." to the outlet: connect it to pdoly8~ (or to its [s]). Nothing is written back. Argument: another preset file (relative to this abstraction) instead of presets/poly800mk2-factory.txt., f 82;
#X obj 20 130 inlet;
#X obj 20 330 text define \$0-bank;
#X obj 330 130 loadbang;
#X obj 330 160 list append \$1;
#X obj 330 190 route float symbol;
#X msg 330 230 read presets/poly800mk2-factory.txt;
#X obj 450 230 list prepend read;
#X obj 450 260 list trim;
#X obj 20 160 moses 0;
#X obj 70 190 t f b;
#X obj 130 220 text size \$0-bank;
#X obj 70 250 moses;
#X obj 70 280 text get \$0-bank;
#X obj 70 310 route pdoly8;
#X obj 70 350 list prepend dump pdoly8;
#X obj 70 380 list trim;
#X obj 70 420 outlet;
#X obj 220 280 list trim;
#X connect 1 0 9 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 5 1 7 0;
#X connect 6 0 2 0;
#X connect 7 0 8 0;
#X connect 8 0 2 0;
#X connect 9 1 10 0;
