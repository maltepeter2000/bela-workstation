#N canvas 0 50 720 470 10;
#X text 10 6 pdoly8~ on Bela with OLED (O2O) - no Pepper, f 43;
#X text 10 21 MIDI: notes / pitch bend / program change 1-64 = factory preset / CC and 14-bit NRPN -> settings, f 96;
#X text 10 36   (table in README \; NRPN: CC 99 = 0 \, CC 98 = the parameter's CC number \, CC 6 / 38 = MSB / LSB), f 94;
#X text 10 51 pdoly8~ smooths every continuous setting (mrph ms) \, the delay glides (dgld 1): no zipper or pops., f 97;
#X text 10 66 OLED: the changed setting and its value \, the program on preset changes - sent by pdoly8~ from a, f 95;
#X text 10 81   thread of its own (oled 127.0.0.1 7562) \, never from the audio thread: no network call \, no print., f 98;
#X text 10 96 Audio in 1 = external FM source (fms 2 \, gain fmig)., f 51;
#N canvas 0 50 700 260 init 0;
#X text 10 6 INIT: open the Bela's own USB MIDI port (hw:0 = computer) \, connect to O2O \, preset 0, f 83;
#X obj 10 40 loadbang;
#X msg 10 70  \; bela_setMidi hw 0 0 0;
#X obj 200 70 del 500;
#X msg 200 100 0;
#X obj 200 125 s p8-preset;
#X msg 400 100 oled 127.0.0.1 7562 \, oledtext pdoly8~ Poly-800;
#X obj 400 125 s p8-in;
#X connect 1 0 2 0;
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 1 0 6 0;
#X connect 6 0 7 0;
