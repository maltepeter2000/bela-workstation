#X obj 60 5194 cnv 10 10 10 empty empty MG\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 5222 One triangle MG for the instrument \, measured on a Poly-800 II. It also drives hmg \, pwm1/2 \, wsm and swm (DCO settings). More LFOs: LFO2 and LFO3 below., f 64;
#X obj 460 5298 s \$0-pdoly8;
#X floatatom 60 5274 6 -1 15 0 - - -;
#X msg 60 5298 mgr \$1;
#X floatatom 160 5274 6 0 30 0 - - -;
#X msg 160 5298 mgf \$1;
#X text 82 5328 mgr (-1): frequency in steps 0-15 as parameter 81 (0: 0.29 Hz / 3: 1.26 / 8: 5.2 / 15: 19 Hz) \, sets mgf. -1 = use mgf. \; mgf (5): the same in Hz., f 64;
