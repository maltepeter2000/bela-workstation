#X obj 60 2218 cnv 10 10 10 empty empty DCO\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 2246 Timbre \, octave and the modulations of the tone generators. Beyond har and oct nothing here is on the Poly-800. All edges stay band-limited. In this order: timbre \, octave \, PWM \, Walsh loop \, sync \, ring., f 64;
#X obj 460 2338 s \$0-pdoly8;
#X floatatom 60 2314 6 0 127 0 - - -;
#X msg 60 2338 har1 \$1;
#X floatatom 160 2314 6 0 127 0 - - -;
#X msg 160 2338 har2 \$1;
#X floatatom 260 2314 6 0 127 0 - - -;
#X msg 260 2338 hmg \$1;
#X text 82 2368 har1 \, har2 (45): timbre of DCO1 / DCO2 \, the same as the controls above (see Timbre). \; hmg (0): the MG moves har1 and har2 by +-hmg steps \, 127 = through the whole timbre path (rate mgr / mgf \, delay mgd)., f 64;
#X obj 460 2460 s \$0-pdoly8;
#X floatatom 60 2436 6 -1 4 0 - - -;
#X msg 60 2460 oct1 \$1;
#X floatatom 160 2436 6 -1 4 0 - - -;
#X msg 160 2460 oct2 \$1;
#X text 82 2490 oct1 \, oct2 (0): -1 0 1 = LOW MID HIGH \, 2-4: the feet one to three octaves higher (the combinations without 16')., f 64;
#X obj 460 2550 s \$0-pdoly8;
#X floatatom 60 2526 6 0 127 0 - - -;
#X msg 60 2550 pw1 \$1;
#X floatatom 160 2526 6 0 127 0 - - -;
#X msg 160 2550 pw2 \$1;
#X floatatom 260 2526 6 0 127 0 - - -;
#X msg 260 2550 pwm1 \$1;
#X floatatom 360 2526 6 0 127 0 - - -;
#X msg 360 2550 pwm2 \$1;
#X text 82 2580 pw1 \, pw2 (64): pulse width 0-127 = 3-97 % \, 64 = square. Every foot becomes the AND of itself and a copy shifted by part of its period (pulse staircases on the saw net). \; pwm1 \, pwm2 (0): the MG moves the width \, 127 = +-47 %., f 64;
#X obj 460 2672 s \$0-pdoly8;
#X floatatom 60 2648 6 0 127 0 - - -;
#X msg 60 2672 wsh1 \$1;
#X floatatom 160 2648 6 0 127 0 - - -;
#X msg 160 2672 wsh2 \$1;
#X floatatom 260 2648 6 0 127 0 - - -;
#X msg 260 2672 wmx1 \$1;
#X floatatom 360 2648 6 0 127 0 - - -;
#X msg 360 2672 wmx2 \$1;
#X text 82 2702 Walsh loop: the four feet are square waves of one counter \, an octave apart. Multiplying them (XOR of the counter bits) gives 15 Walsh functions \, square-like waves with 1 to 8 cycles per 16' period (sequency) and their energy near that harmonic. They come from the same counter edges \, so they are exactly in tune and band-limited - a wavetable the chip already has. The loop orders them by sequency: moving along it sweeps the energy from the 16' up to the 8th harmonic and back \, neighbours fading at equal power. \; wsh1 \, wsh2 (0): position on the loop 0-127 (0: 16' / 17: 16'x4' / 59: 2' / 85: all four / 119: 16'x8' / 127 = 0 again). \; wmx1 \, wmx2 (0): mix from the normal feet (0) to the loop (127)., f 64;
#X obj 460 2938 s \$0-pdoly8;
#X floatatom 60 2914 6 0 127 0 - - -;
#X msg 60 2938 wsm \$1;
#X floatatom 160 2914 6 -127 127 0 - - -;
#X msg 160 2938 wse \$1;
#X text 82 2968 wsm (0): the MG moves the position +-wsm steps (127: the whole loop \, a sweeping \, vocal sound - try mgr 2-8). \; wse (0): DEG3 moves the position by up to wse steps (-127..127) \, e.g. a bright attack falling into the 16'. wsm and wse act where wmx is above 0., f 64;
#X obj 460 3076 s \$0-pdoly8;
#X floatatom 60 3052 6 0 1 0 - - -;
#X msg 60 3076 sync \$1;
#X floatatom 160 3052 6 0 72 0 - - -;
#X msg 160 3076 swp2 \$1;
#X floatatom 260 3052 6 0 72 0 - - -;
#X msg 260 3076 swe \$1;
#X floatatom 360 3052 6 0 24 0 - - -;
#X msg 360 3076 swm \$1;
#X text 82 3106 sync (0): 1: DCO2's counter restarts at every 16' period of DCO1 \, at the exact sub-sample time. \; swp2 (0): DCO2 offset 0-72 semitones. \; swe (0): DEG3 adds up to 0-72 semitones to DCO2. \; swm (0): the MG adds +-0-24 semitones to DCO2. Screaming sync: sync 1 \, lev1 low \, lev2 high \, swe 40-72 \, a falling DEG3 (d3 \, su3 0) \, res and drv up. The sweeps also work without sync., f 64;
#X obj 460 3246 s \$0-pdoly8;
#X floatatom 60 3222 6 0 127 0 - - -;
#X msg 60 3246 ring \$1;
#X floatatom 160 3222 6 0 14 0 - - -;
#X msg 160 3246 rmf \$1;
#X text 82 3276 ring (0): 0-127 \, DCO2 is multiplied by a +-1 wave of DCO1 (XOR \, the ring modulation of square waves). At 127 only sum and difference tones remain \, lev1 0 for the pure ring sound. \; rmf (0): the modulator \, a step 0-14 on the Walsh loop of DCO1: 0 its 16' (softest) \, 1 8' \, 3 4' \, 7 2' \, 10 all four feet \, back down to 14 16'x8'. Steps towards 7 move the sidebands further apart: stronger \, more metallic., f 64;
#X obj 60 3402 cnv 10 10 10 empty empty FM 24 6 0 14 #1e3791 #000000 0;
#X text 82 3430 Linear FM of the counter rate \, through zero (the counter runs backwards) above index 1 \, every edge band-limited. Not on the Poly-800., f 64;
#X obj 460 3506 s \$0-pdoly8;
#X floatatom 60 3482 6 0 127 0 - - -;
#X msg 60 3506 fm1 \$1;
#X floatatom 160 3482 6 0 127 0 - - -;
#X msg 160 3506 fm2 \$1;
#X text 82 3536 fm1 \, fm2 (0): depth on DCO1 / DCO2 \, 0-127 = index 0-16 (1 at about 32) \, 0 = off., f 64;
#X obj 460 3596 s \$0-pdoly8;
#X floatatom 60 3572 6 0 2 0 - - -;
#X msg 60 3596 fms \$1;
#X floatatom 160 3572 6 0.125 16 0 - - -;
#X msg 160 3596 fmr \$1;
#X floatatom 260 3572 6 -1000 1000 0 - - -;
#X msg 260 3596 fmhz \$1;
#X floatatom 360 3572 6 0 127 0 - - -;
#X msg 360 3596 fmig \$1;
#X obj 460 3626 s \$0-pdoly8;
#X msg 60 3626 fms 0;
#X msg 190 3626 fms 1;
#X msg 320 3626 fms 2;
#X floatatom 60 3660 6 0 0 0 - - -;
#X obj 60 3688 osc~ 110;
#X obj 60 3716 s~ \$0-fmin;
#X text 150 3688 external modulator (fms 2);
#X text 82 3746 fms (0): chooses the modulator \, it switches nothing on or off: 0 a sine per DCO at fmr x its own 16' frequency plus fmhz \, 1 the other DCO of the voice (cross FM: DCO2 into DCO1 and DCO1 into DCO2) \, 2 the signal at the right inlet (about -1..1: osc~ \, adc~ \, noise~ ...) \, here from the osc~ above. \; fmr (1): 0.125-16 \, whole ratios stay harmonic \, others (1.41 \, 3.5) give bells and metal that follow the key. \; fmhz (0): -1000..1000 Hz added to the sine: a fixed \, inharmonic offset with the same beat on every key (fmr 0.125 \, fmhz 200: almost a fixed modulator). \; fmig (64): gain of the signal at the right inlet (fms 2) \, 64 = 1 \, 127 = about 2., f 64;
#X obj 60 3952 cnv 10 10 10 empty empty Filter\ &\ DEG3\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 3980 One 4-pole VCF for the instrument (NJM2069) and one DEG3 for all voices \, measured on a Poly-800 II., f 64;
#X obj 460 4040 s \$0-pdoly8;
