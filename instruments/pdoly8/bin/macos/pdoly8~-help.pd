#X obj 60 4726 cnv 10 10 10 empty empty MG\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 4754 One triangle MG for the instrument \, measured on a Poly-800 II. It also drives hmg \, pwm1/2 \, wsm and swm (DCO settings). More LFOs: LFO2 and LFO3 below., f 64;
#X obj 460 4830 s \$0-pdoly8;
#X floatatom 60 4806 6 -1 15 0 - - -;
#X msg 60 4830 mgr \$1;
#X floatatom 160 4806 6 0 30 0 - - -;
#X msg 160 4830 mgf \$1;
#X text 82 4860 mgr (-1): frequency in steps 0-15 as parameter 81 (0: 0.29 Hz / 3: 1.26 / 8: 5.2 / 15: 19 Hz) \, sets mgf. -1 = use mgf. \; mgf (5): the same in Hz., f 64;
#X obj 460 4936 s \$0-pdoly8;
