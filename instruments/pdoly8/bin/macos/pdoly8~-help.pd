#X obj 60 2606 cnv 10 10 10 empty empty DCO\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 2634 Timbre \, octave and the modulations of the tone generators. Beyond har and oct nothing here is on the Poly-800. All edges stay band-limited. In this order: timbre \, octave \, PWM \, Walsh loop \, sync \, ring., f 64;
#X obj 460 2726 s \$0-pdoly8;
#X floatatom 60 2702 6 0 127 0 - - -;
#X msg 60 2726 har1 \$1;
#X floatatom 160 2702 6 0 127 0 - - -;
#X msg 160 2726 har2 \$1;
#X floatatom 260 2702 6 0 127 0 - - -;
#X msg 260 2726 hmg \$1;
#X text 82 2756 har1 \, har2 (45): timbre of DCO1 / DCO2 \, the same as the controls above (see Timbre). \; hmg (0): the MG moves har1 and har2 by +-hmg steps \, 127 = through the whole timbre path (rate mgr / mgf \, delay mgd)., f 64;
#X obj 460 2848 s \$0-pdoly8;
#X floatatom 60 2824 6 -1 4 0 - - -;
#X msg 60 2848 oct1 \$1;
#X floatatom 160 2824 6 -1 4 0 - - -;
#X msg 160 2848 oct2 \$1;
#X text 82 2878 oct1 \, oct2 (0): -1 0 1 = LOW MID HIGH \, 2-4: the feet one to three octaves higher (the combinations without 16')., f 64;
#X obj 460 2938 s \$0-pdoly8;
#X floatatom 60 2914 6 0 127 0 - - -;
#X msg 60 2938 pw1 \$1;
#X floatatom 160 2914 6 0 127 0 - - -;
#X msg 160 2938 pw2 \$1;
#X floatatom 260 2914 6 0 127 0 - - -;
#X msg 260 2938 pwm1 \$1;
#X floatatom 360 2914 6 0 127 0 - - -;
#X msg 360 2938 pwm2 \$1;
#X text 82 2968 pw1 \, pw2 (64): pulse width 0-127 = 3-97 % \, 64 = square. Every foot becomes the AND of itself and a copy shifted by part of its period (pulse staircases on the saw net). \; pwm1 \, pwm2 (0): the MG moves the width \, 127 = +-47 %., f 64;
#X obj 460 3060 s \$0-pdoly8;
#X floatatom 60 3036 6 0 127 0 - - -;
#X msg 60 3060 wsh1 \$1;
#X floatatom 160 3036 6 0 127 0 - - -;
#X msg 160 3060 wsh2 \$1;
#X floatatom 260 3036 6 0 127 0 - - -;
#X msg 260 3060 wmx1 \$1;
#X floatatom 360 3036 6 0 127 0 - - -;
#X msg 360 3060 wmx2 \$1;
#X text 82 3090 Walsh loop: the four feet are square waves of one counter \, an octave apart. Multiplying them (XOR of the counter bits) gives 15 Walsh functions \, square-like waves with 1 to 8 cycles per 16' period (sequency) and their energy near that harmonic. They come from the same counter edges \, so they are exactly in tune and band-limited - a wavetable the chip already has. The loop orders them by sequency: moving along it sweeps the energy from the 16' up to the 8th harmonic and back \, neighbours fading at equal power. \; wsh1 \, wsh2 (0): position on the loop 0-127 (0: 16' / 17: 16'x4' / 59: 2' / 85: all four / 119: 16'x8' / 127 = 0 again). \; wmx1 \, wmx2 (0): mix from the normal feet (0) to the loop (127)., f 64;
#X obj 460 3326 s \$0-pdoly8;
#X floatatom 60 3302 6 0 127 0 - - -;
#X msg 60 3326 wsm \$1;
#X floatatom 160 3302 6 -127 127 0 - - -;
#X msg 160 3326 wse \$1;
#X text 82 3356 wsm (0): the MG moves the position +-wsm steps (127: the whole loop \, a sweeping \, vocal sound - try mgr 2-8). \; wse (0): DEG3 moves the position by up to wse steps (-127..127) \, e.g. a bright attack falling into the 16'. wsm and wse act where wmx is above 0., f 64;
#X obj 460 3464 s \$0-pdoly8;
#X floatatom 60 3440 6 0 1 0 - - -;
#X msg 60 3464 sync \$1;
#X floatatom 160 3440 6 0 72 0 - - -;
#X msg 160 3464 swp2 \$1;
#X floatatom 260 3440 6 0 72 0 - - -;
#X msg 260 3464 swe \$1;
#X floatatom 360 3440 6 0 24 0 - - -;
#X msg 360 3464 swm \$1;
#X text 82 3494 sync (0): 1: DCO2's counter restarts at every 16' period of DCO1 \, at the exact sub-sample time. \; swp2 (0): DCO2 offset 0-72 semitones. \; swe (0): DEG3 adds up to 0-72 semitones to DCO2. \; swm (0): the MG adds +-0-24 semitones to DCO2. Screaming sync: sync 1 \, lev1 low \, lev2 high \, swe 40-72 \, a falling DEG3 (d3 \, su3 0) \, res and drv up. The sweeps also work without sync., f 64;
#X obj 460 3634 s \$0-pdoly8;
#X floatatom 60 3610 6 0 127 0 - - -;
#X msg 60 3634 ring \$1;
#X floatatom 160 3610 6 0 14 0 - - -;
#X msg 160 3634 rmf \$1;
#X text 82 3664 ring (0): 0-127 \, DCO2 is multiplied by a +-1 wave of DCO1 (XOR \, the ring modulation of square waves). At 127 only sum and difference tones remain \, lev1 0 for the pure ring sound. \; rmf (0): the modulator \, a step 0-14 on the Walsh loop of DCO1: 0 its 16' (softest) \, 1 8' \, 3 4' \, 7 2' \, 10 all four feet \, back down to 14 16'x8'. Steps towards 7 move the sidebands further apart: stronger \, more metallic., f 64;
#X obj 60 3790 cnv 10 10 10 empty empty FM 24 6 0 14 #1e3791 #000000 0;
#X text 82 3818 Linear FM of the counter rate \, through zero (the counter runs backwards) above index 1 \, every edge band-limited. Not on the Poly-800., f 64;
#X obj 460 3894 s \$0-pdoly8;
#X floatatom 60 3870 6 0 127 0 - - -;
#X msg 60 3894 fm1 \$1;
#X floatatom 160 3870 6 0 127 0 - - -;
#X msg 160 3894 fm2 \$1;
#X text 82 3924 fm1 \, fm2 (0): depth on DCO1 / DCO2 \, 0-127 = index 0-16 (1 at about 32) \, 0 = off., f 64;
#X obj 460 3984 s \$0-pdoly8;
#X floatatom 60 3960 6 0 2 0 - - -;
#X msg 60 3984 fms \$1;
#X floatatom 160 3960 6 0.125 16 0 - - -;
#X msg 160 3984 fmr \$1;
#X floatatom 260 3960 6 -1000 1000 0 - - -;
#X msg 260 3984 fmhz \$1;
#X floatatom 360 3960 6 0 127 0 - - -;
#X msg 360 3984 fmig \$1;
#X obj 460 4014 s \$0-pdoly8;
#X msg 60 4014 fms 0;
#X msg 190 4014 fms 1;
#X msg 320 4014 fms 2;
#X floatatom 60 4048 6 0 0 0 - - -;
#X obj 60 4076 osc~ 110;
#X obj 60 4104 s~ \$0-fmin;
#X text 150 4076 external modulator (fms 2);
#X text 82 4134 fms (0): chooses the modulator \, it switches nothing on or off: 0 a sine per DCO at fmr x its own 16' frequency plus fmhz \, 1 the other DCO of the voice (cross FM: DCO2 into DCO1 and DCO1 into DCO2) \, 2 the signal at the right inlet (about -1..1: osc~ \, adc~ \, noise~ ...) \, here from the osc~ above. \; fmr (1): 0.125-16 \, whole ratios stay harmonic \, others (1.41 \, 3.5) give bells and metal that follow the key. \; fmhz (0): -1000..1000 Hz added to the sine: a fixed \, inharmonic offset with the same beat on every key (fmr 0.125 \, fmhz 200: almost a fixed modulator). \; fmig (64): gain of the signal at the right inlet (fms 2) \, 64 = 1 \, 127 = about 2., f 64;
#X obj 60 4340 cnv 10 10 10 empty empty Filter\ &\ DEG3\ settings 24 6 0 14 #1e3791 #000000 0;
#X text 82 4368 One 4-pole VCF for the instrument (NJM2069) and one DEG3 for all voices \, measured on a Poly-800 II., f 64;
#X obj 460 4428 s \$0-pdoly8;
