#X msg 60 5016 mgi \$1;
#X floatatom 160 4992 6 0 15 0 - - -;
#X msg 160 5016 mgd \$1;
#X text 82 5046 mgi (0): depth on the pitch in cents (83: 12.4 cents per step \, 186 at 15) \, a 14.5 Hz low-pass makes fast vibrato shallower \, as on the original. \; mgd (0): delay 0-15 (82: 0.47 s at 5 \, 1.55 s at 15) from the first key \, then full depth., f 64;
#X obj 460 5154 s \$0-pdoly8;
#X floatatom 60 5130 6 0 15 0 - - -;
