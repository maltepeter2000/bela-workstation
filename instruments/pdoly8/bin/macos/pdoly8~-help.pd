#X msg 60 8118 a1 \$1;
#X floatatom 160 8094 6 0 31 0 - - -;
#X msg 160 8118 d1 \$1;
#X floatatom 260 8094 6 0 31 0 - - -;
#X msg 260 8118 bp1 \$1;
#X floatatom 360 8094 6 0 31 0 - - -;
#X msg 360 8118 sl1 \$1;
