#X floatatom 260 4016 6 0 2 0 - - -;
#X msg 260 4040 kbd \$1;
#X text 82 4070 cut (99): 0-99 = 66 Hz - 20 kHz \, 13 steps per octave. \; res (0): 0-15 \, an uncompensated ladder (the bass falls as it rises) \, no self-oscillation. \; kbd (0): key tracking of the highest key: 0 off \, 2 full (1:1 \, C4 nominal) \, 1 half (1:2 \, C6 nominal)., f 64;
#X obj 460 4178 s \$0-pdoly8;
#X floatatom 60 4154 6 0 15 0 - - -;
#X msg 60 4178 egi \$1;
#X floatatom 160 4154 6 1 2 0 - - -;
#X msg 160 4178 pol \$1;
#X floatatom 260 4154 6 1 2 0 - - -;
#X msg 260 4178 trg \$1;
#X text 82 4208 egi (0): EG INT 0-15 \, DEG3 moves the cutoff up to 7.9 octaves. \; pol (2): 2 up \, 1 down. \; trg (2): 2 multi: every key restarts DEG3 \, 1 single: only the first key of a phrase., f 64;
#X obj 460 4300 s \$0-pdoly8;
#X floatatom 60 4276 6 -1 127 0 - - -;
#X msg 60 4300 env3 \$1;
