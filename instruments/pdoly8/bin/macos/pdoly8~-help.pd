#X floatatom 60 8254 6 0 127 0 - - -;
#X msg 60 8278 vamp \$1;
#X text 82 8308 vamp (0): velocity to the level of each voice (both DCOs \, not on the Poly-800): 0 off \, 127 level = velocity., f 64;
#X obj 60 8354 cnv 10 10 10 empty empty Portamento 24 6 0 14 #1e3791 #000000 0;
#X text 82 8382 Not on the Poly-800., f 64;
#X obj 460 8426 s \$0-pdoly8;
#X floatatom 60 8402 6 0 127 0 - - -;
#X msg 60 8426 port \$1;
#X floatatom 160 8402 6 0 2 0 - - -;
#X msg 160 8426 pmod \$1;
#X text 82 8456 port (0): glide time 0-127 = off to 3 s. \; pmod (0): where a glide starts: 0 from the last note played \, 1 from the note this voice played before \, 2 from the last note only while another key is still held (legato glide). pmod is not a mono / poly switch., f 64;
#X obj 460 8564 s \$0-pdoly8;
#X floatatom 60 8540 6 0 1 0 - - -;
#X msg 60 8564 mono \$1;
#X floatatom 160 8540 6 0 1 0 - - -;
#X msg 160 8564 retr \$1;
#X text 82 8594 mono (0): 0 poly (4 voices) \, 1 mono: one voice \, the last key wins. \; retr (1): in mono \, 1: every key restarts the envelopes \, 0: legato \, only the first key of a phrase restarts them \, further keys (and going back to a held one) only change the pitch., f 64;
#X obj 60 8688 cnv 10 10 10 empty empty Additional\ settings 24 6 0 14 #1e3791 #000000 0;
#X obj 460 8740 s \$0-pdoly8;
#X floatatom 60 8716 6 0 12 0 - - -;
#X msg 60 8740 bnd \$1;
#X floatatom 160 8716 6 0 16 0 - - -;
#X msg 160 8740 ch1 \$1;
#X text 82 8770 bnd (2): bend range in semitones (original: up to 7). Pitch bend from a MIDI keyboard comes in through [bendin] at the top. \; ch1 (0): MIDI channel for p v ch lists \, 0 = any., f 64;
#X obj 460 8862 s \$0-pdoly8;
#X floatatom 60 8838 6 -6 6 0 - - -;
#X msg 60 8862 treb \$1;
#X floatatom 160 8838 6 -6 6 0 - - -;
#X msg 160 8862 bass \$1;
#X text 82 8892 treb \, bass (0): EQ -6..6 (76/77 \, measured: about 4 dB at 3 \, 10 dB at 6 \, shelves at 4.3 kHz and 115 Hz)., f 64;
#X obj 460 8952 s \$0-pdoly8;
#X floatatom 60 8928 6 0 127 0 - - -;
#X msg 60 8952 sprd \$1;
#X floatatom 160 8928 6 0 100 0 - - -;
#X msg 160 8952 mrph \$1;
#X text 82 8982 sprd (0): stereo spread of the 4 voices 0-127. \; mrph (8): smoothing of har and lev changes in ms., f 64;
#X obj 460 9042 s \$0-pdoly8;
#X floatatom 60 9018 6 0 1 0 - - -;
#X msg 60 9042 tone \$1;
#X floatatom 160 9018 6 0 1 0 - - -;
#X msg 160 9042 leak \$1;
#X text 82 9072 tone (1): 1: output stage measured on a Poly-800 (54 Hz high-pass \, VCF \, 1 pole at 5 kHz) \, 0: raw tone generators. \; leak (0): 1: released voices stay at -55 dB \, as on the original., f 64;
#X obj 460 9164 s \$0-pdoly8;
#X floatatom 60 9140 6 0 127 0 - - -;
#X msg 60 9164 drft \$1;
#X text 82 9194 drft (0): analogue drift (not on the Poly-800 \, whose pitch comes from a crystal and dividers) \, like the slop / vintage knob of newer Sequential instruments: every DCO of every voice wanders slowly and on its own (at 127 about +-3 cents \, peaks about 8) \, each note's envelopes run a little faster or slower (+-20 % \, DEG3 too) \, the MG rate wanders +-10 % and the cutoff +-0.2 octaves. 0 = exact., f 64;
#X text 82 9320 Credits: Modelled on the Korg Poly-800 service manual\; \; MSM5232\; scale ROM data as documented in MAME's \; msm5232.cpp with help by Claude, f 64;
