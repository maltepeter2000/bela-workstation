#N canvas 0 50 520 330 10;
#X text 10 6 p8pot: deadband for a pot or CV (0-127). Passes a value only when it moved by 2 or more (or reached 0 / 127) \, so a resting pot does not override a preset., f 100;
#X obj 10 50 inlet;
#X obj 10 80 t f f;
#X obj 100 110 expr abs(\$f1 - \$f2) >= 2 || (\$f1 != \$f2 && (\$f1 <= 0 || \$f1 >= 127));
#X obj 10 150 spigot;
#X obj 10 180 t f f;
#X obj 10 220 outlet;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 3 0 4 1;
#X connect 2 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 5 1 3 1;
