#N canvas 0 50 720 470 10;
#X text 10 6 pdoly8~ on Bela with OLED (O2O) - no Pepper, f 43;
#X text 10 21 MIDI: notes / pitch bend / program change 1-64 = factory preset / CC pages on channel 1 -> settings, f 99;
#X text 10 36   (controller layer p8cc: table in README \, changes go back to the controller \, pickup), f 85;
#X text 10 51 pdoly8~ smooths every continuous setting (mrph ms) \, the delay glides (dgld 1): no zipper or pops., f 97;
#X text 10 66 OLED: the changed setting and its value \, the program on preset changes - sent by pdoly8~ from a, f 95;
#X text 10 81   thread of its own (oled 127.0.0.1 7562) \, never from the audio thread: no network call \, no print., f 98;
#X text 10 96 Audio in 1 = external FM source (depth extfm)., f 46;
#N canvas 0 50 700 260 init 0;
#X text 10 6 INIT: open the Bela's own USB MIDI port (hw:0 = computer) \, connect to O2O \, preset 0, f 83;
#X obj 10 40 loadbang;
#X msg 10 70  \; bela_setMidi hw 0 0 0;
#X obj 200 70 del 500;
#X msg 200 100 0;
#X obj 200 125 s p8-preset;
#X msg 400 100 oled 127.0.0.1 7562 \, oledtext pdoly8~ Poly-800;
#X obj 400 125 s p8-in;
#X connect 1 0 2 0;
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 1 0 6 0;
#X connect 6 0 7 0;
#X restore 10 110 pd init;
#X text 140 110 MIDI port / O2O / preset 0 at start, f 35;
#N canvas 0 50 640 280 presets 0;
#X text 10 6 PRESETS: p8-preset N loads factory program N (0-63) and shows it (program 11 ... 88), f 84;
#X obj 10 40 r p8-preset;
#X obj 10 65 mod 64;
#X obj 10 90 t f f;
#X obj 10 120 p8factory;
#X obj 10 145 s p8-in;
#X obj 200 120 expr (int(\$f1 / 8) + 1) * 10 + \$f1 % 8 + 1;
#X obj 200 145 makefilename %d;
#X msg 200 170 oledtext Program \$1;
#X obj 200 195 s p8-in;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 1 4 0;
#X connect 4 0 5 0;
#X connect 3 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X restore 10 135 pd presets;
#X text 140 135 factory presets, f 15;
#N canvas 0 50 900 460 midi 0;
#X text 10 6 MIDI: notes / pitch bend / program change / CC pages (controller layer p8cc) -> p8-in, f 85;
#X obj 10 40 notein;
#X obj 10 70 pack f f f;
#X obj 10 100 s p8-in;
#X obj 200 40 bendin;
#X obj 200 70 expr (\$f1 - 8192) / 8192;
#X msg 200 100 bend \$1;
#X obj 200 125 s p8-in;
#X obj 450 40 pgmin;
#X obj 450 70 - 1;
#X obj 450 100 s p8-preset;
#X obj 10 140 r p8-out;
#X obj 10 170 p8cc 1;
#X obj 10 200 s p8-in;
#X text 100 170 p8cc 1: controller layer - CC pages on channel 1 -> n <name> <value> \, changes back to the controller (ctlout) \, pickup (table inside p8cc.pd), f 100;
