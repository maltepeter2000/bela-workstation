#N canvas 0 50 980 760 10;
#X text 10 6 cz4pads (cz4~): control pads - the Launchkey's pads in Drum mode (notes 36-51 \, top row 36-43) on channel \$1 (0 = 10 \, the Drums Channel) -> a message to the instrument. Inlet: channel <n> \, leds (send the pad colours again). Generated by common/tools/ctpads.py., f 100;
#X obj 10 40 loadbang;
#X obj 10 65 f \$1;
#X obj 10 90 expr if(\$f1 > 0 \, \$f1 \, 10);
#X obj 260 40 inlet;
#X obj 260 65 route channel leds;
#X text 10 505 pad LEDs: velocity = colour + 32 * mode (common/tools/ctpads.py \, launchkey/README.md), f 85;
#X obj 10 530 r \$0-led;
#X obj 10 555 unpack f f;
#X obj 10 585 noteout;
#X obj 10 115 t f f;
#X obj 400 530 t b;
#X msg 400 560 36 7 \, 37 5 \, 38 3 \, 39 0 \, 40 0 \, 41 0 \, 42 0 \, 43 0 \, 44 7 \, 45 5 \, 46 2 \, 47 0 \, 48 0 \, 49 0 \, 50 0 \, 51 0;
#X obj 400 620 s \$0-led;
#X obj 600 530 ctlin 3;
#X obj 600 555 pack f f;
#X obj 600 605 expr \$f1 > 0 && \$f2 == \$f3;
#X obj 600 580 unpack f f;
#X obj 600 630 sel 1;
