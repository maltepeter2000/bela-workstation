#X msg 160 3050 ringmod \$1;
#X floatatom 260 3026 6 -1 1 0 - - - 0;
#X msg 260 3050 octave \$1;
#X floatatom 360 3026 6 1 15 0 - - - 0;
#X msg 360 3050 level \$1;
#X text 82 3080 window (tone): window of the resonance waves (CZ waves 6 \, 7 \, 8 = saw \, tri \, trap). Values: 0 off \, 1 saw \, 2 tri \, 3 trap \, 4 pulse \, 5 dsaw \, 6 dsaw6 \, 7 dsaw7. \; ringmod (tone): line 2 ring-modulated by line 1 \, or its pitch by noise (1+1' and 1+2'). Values: 0 off \, 1 ring \, 2 noise. \; octave (tone): octave of the tone. Values: -1 -1 \, 0 0 \, 1 +1. \; level (tone): level of the line (CZ-1)., f 64;
