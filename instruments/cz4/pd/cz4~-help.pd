#X floatatom 160 2824 6 0 3 0 - - - 0;
#X msg 160 2848 linesel \$1;
#X floatatom 260 2824 6 0 7 0 - - - 0;
#X msg 260 2848 wave \$1;
#X floatatom 360 2824 6 0 8 0 - - - 0;
#X msg 360 2848 wave2 \$1;
#X text 82 2878 line (0): the line that the line and envelope controls edit. Values: 0 1 \, 1 2. \; linesel (tone): line 1 \, line 2 \, line 1 twice (line 2 detuned) \, both lines. Values: 0 1 \, 1 2 \, 2 1+1' \, 3 1+2'. \; wave (tone): first wave of the line. Values: 0 saw \, 1 square \, 2 pulse \, 3 null \, 4 dsine \, 5 sawpuls \, 6 reso \, 7 pulse2. \; wave2 (tone): second wave: the line alternates the two every cycle. Values: 0 off \, 1 saw \, 2 square \, 3 pulse \, 4 null \, 5 dsine \, 6 sawpuls \, 7 reso \, 8 pulse2., f 64;
#X obj 460 3050 s \$0-cz4;
#X floatatom 60 3026 6 0 7 0 - - - 0;
#X msg 60 3050 window \$1;
