#X floatatom 60 4412 6 -50 50 0 - - - 0;
#X msg 60 4436 tune \$1;
#X floatatom 160 4412 6 1 8 0 - - - 0;
#X msg 160 4436 voices \$1;
#X text 82 4466 tune (0): master tune in cents. \; voices (8): polyphony per tone. A patch that uses one tone plays twice as many notes., f 64;
#X obj 460 4542 s \$0-d50;
#X floatatom 60 4518 6 0 1 0 - - - 0;
#X msg 60 4542 governor \$1;
#X text 82 4572 governor (0): when 1 \, the object ends the oldest released note early whenever a block takes longer to compute than it lasts. Held notes are never ended. Meant for small machines such as Bela., f 64;
#X obj 60 4650 cnv 10 10 10 empty empty Performance\ and\ setup\ controls 24 6 0 14 #1e3791 #000000 0;
#X text 82 4678 cut -63..63 \, CC 20: cutoff of every synth partial \, also of \;   notes that are sounding. 0 leaves the patch as it is \; res -63..63 \, CC 21: resonance of every synth partial \, for the \;   notes that follow \; att -63..63 \, CC 22: attack (TVA time 1) of all four partials \, \;   for the notes that follow \; rel -63..63 \, CC 23: release (TVA and TVF time 5) of all four \;   partials \, for the notes that follow \; chorus 0..100 \, CC 24: chorus balance of both tones \; reverb 0..100 \, CC 25: reverb balance of the patch \; balance 0..100 \, CC 26: balance of the two tones \, lower at 0 \, \;   upper at 100 \; volume 0..100 \, CC 27: master volume \, not stored in a patch \; part 0..3 \, CC 28: the partial the partial names act on \, and \;   with it the tone (U1 U2: upper \, L1 L2: lower) \; tune -50..50: master tune in cents \, not stored in a patch \; voices 1..8: polyphony per tone \, not stored in a patch, f 64;
#X obj 60 4964 cnv 10 10 10 empty empty Partial\ controls:\ the\ selected\ partial 24 6 0 14 #1e3791 #000000 0;
#X text 82 4992 coarse 0..72 \, CC 29: pitch in semitones \, 0 is C1 \; fine -50..50 \, CC 30: fine tune \; keyfollow 0..16 \, CC 31: pitch keyfollow step \, 11 is a semitone \;   per key \; lfomode 0..3: pitch LFO: off \, + \, - \, aftertouch and lever \; penvmode 0..2: pitch envelope: off \, + \, - \; bendmode 0..2: bender: off \, keyfollow \, normal \; wave 0..1 \, CC 33: synth waveform: square \, sawtooth \; pcm 1..100 \, CC 34: PCM sample \; pw 0..100 \, CC 35: pulse width \; pwvelo -7..7: pulse width by velocity \; pwlfo 0..5: pulse width LFO: +1 \, -1 \, +2 \, -2 \, +3 \, -3 \; pwlfodepth 0..100 \, CC 36: pulse width LFO depth \; pwat -7..7: pulse width by aftertouch \; cutoff 0..100 \, CC 37: filter cutoff \; reso 0..30 \, CC 39: filter resonance \; tvfkf 0..14 \, CC 40: cutoff keyfollow step \; tvfbiaspoint 0..127: cutoff bias point and direction \; tvfbiaslevel -7..7: cutoff bias level \; tvfenv 0..100 \, CC 41: filter envelope depth \; tvfvelo 0..100 \, CC 42: filter envelope depth by velocity \; tvfdepthkf 0..4: filter envelope depth keyfollow \; tvftimekf 0..4: filter envelope time keyfollow \; tvft1 to tvft5 0..100 \, CC 46 to 50: filter envelope times \; tvfl1 to tvfl3 0..100 \, CC 51 to 53: filter envelope levels \; tvfsustain 0..100 \, CC 43: filter envelope sustain level \; tvfend 0..1: filter envelope end level: 0 \, 100 \; tvflfo 0..5: filter LFO \, as pwlfo \; tvflfodepth 0..100 \, CC 44: filter LFO depth \; tvfat -7..7 \, CC 45: cutoff by aftertouch \; level 0..100 \, CC 54: level of the partial \; velo -50..50 \, CC 55: level by velocity \; tvabiaspoint 0..127 \, CC 59: level bias point and direction \; tvabiaslevel -12..0 \, CC 60: level bias level \; tvat1 to tvat5 0..100 \, CC 62 to 72: level envelope times \; tval1 to tval3 0..100 \, CC 73 to 75: level envelope levels \; tvasustain 0..100 \, CC 56: level envelope sustain level \; tvaend 0..1: level envelope end level: 0 \, 100 \; tvavelofollow 0..4 \, CC 61: level envelope time 1 by velocity \; tvatimekf 0..4: level envelope time keyfollow \; tvalfo 0..5: level LFO \, as pwlfo \; tvalfodepth 0..100 \, CC 57: level LFO depth \; tvaat -7..7 \, CC 58: level by aftertouch, f 64;
#X obj 60 5694 cnv 10 10 10 empty empty Tone\ controls:\ its\ tone 24 6 0 14 #1e3791 #000000 0;
#X text 82 5722 structure 1..7 \, CC 76: S+S \, S+S ring \, P+S \, P+S ring \, S+P ring \, \;   P+P \, P+P ring \; penvvelo 0..2 \, CC 82: pitch envelope by velocity \; penvtimekf 0..4 \, CC 83: pitch envelope time keyfollow \; penvt1 to penvt4 0..50 \, CC 85 to 89: pitch envelope times \; penvl0 to penvl2 -50..50 \, CC 90 to 92: pitch envelope levels \; penvsustain -50..50 \, CC 93: pitch envelope sustain level \; penvend -50..50: pitch envelope end level \; pmodlfo 0..100 \, CC 79: pitch LFO depth \; pmodlever 0..100 \, CC 80: pitch LFO depth by the lever \; pmodat 0..100 \, CC 81: pitch LFO depth by aftertouch \; lfo1wave 0..3 \, CC 94: triangle \, sawtooth \, square \, random \; lfo1rate 0..100 \, CC 95: LFO 1 rate \; lfo1delay 0..100 \, CC 102: LFO 1 delay \; lfo1sync 0..2 \, CC 103: off \, on \, key \; lfo2wave 0..3 \, CC 104: as lfo1wave \; lfo2rate 0..100 \, CC 105: LFO 2 rate \; lfo2delay 0..100 \, CC 106: LFO 2 delay \; lfo2sync 0..1 \, CC 107: off \, on \; lfo3wave 0..3 \, CC 108: as lfo1wave \; lfo3rate 0..100 \, CC 109: LFO 3 rate \; lfo3delay 0..100 \, CC 110: LFO 3 delay \; lfo3sync 0..1 \, CC 111: off \, on \; eqlowfreq 0..15 \, CC 112: low shelf frequency step \; eqlowgain -12..12 \, CC 113: low shelf gain in dB \; eqhighfreq 0..21 \, CC 114: high band frequency step \; eqhighq 0..8 \, CC 119: high band width step \; eqhighgain -12..12 \, CC 115: high band gain in dB \; chorustype 1..8 \, CC 116: chorus type \; chorusrate 0..100 \, CC 117: chorus rate \; chorusdepth 0..100 \, CC 118: chorus depth \; tchorus 0..100: chorus balance of this tone \; mute 0..3 \, CC 78: partials sounding: none \, first \, second \, both \; pbal 0..100 \, CC 77: balance of the two partials, f 64;
#X obj 60 6280 cnv 10 10 10 empty empty Patch\ controls 24 6 0 14 #1e3791 #000000 0;
#X text 82 6308 keymode 0..8: whole \, dual \, split \, whole solo \, dual solo \, split \;   upper solo \, split lower solo \, separate \, separate solo \; split 0..60: split point \, 0 is C2 \; portamode 0..2: portamento on upper \, lower \, both \; ukeyshift to lkeyshift -24..24: key shift of each tone in \;   semitones \; ufine to lfine -50..50: fine tune of each tone \; bendrange 0..12: bender range in semitones \; atbend -12..12: pitch bend by aftertouch in semitones \; portatime 0..100: portamento time \; outmode 1..4: how the tones go to reverb and outputs \; reverbtype 1..32: reverb type \; reverb 0..100 \, CC 25: reverb balance \; pvol 0..100: level of the patch \, volume is the master \; balance 0..100 \, CC 26: balance of the two tones \; porta 0..1: portamento switch, f 64;
