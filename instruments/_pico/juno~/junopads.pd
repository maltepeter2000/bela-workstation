#N canvas 0 50 980 520 10;
#X text 10 6 junopads (juno~): control pads - the Launchkey's pads in Drum mode (notes 36-51 \, top row 36-43) on channel \$1 (0 = 10 \, the Drums Channel) -> a message to the instrument. Inlet: channel <n>., f 100;
#X obj 10 40 loadbang;
#X obj 10 65 f \$1;
#X obj 10 90 expr if(\$f1 > 0 \, \$f1 \, 10);
#X obj 260 40 inlet;
#X obj 260 65 route channel;
#X obj 10 130 notein;
#X obj 10 160 pack f f f;
#X obj 10 190 expr \$f2 > 0 && \$f3 == \$f4;
#X obj 10 215 unpack f f f;
#X obj 10 240 t l l;
#X obj 120 270 spigot;
#X obj 120 245 unpack f f f;
#X obj 120 300 sel 36 37 38 39 40 41 42 43 45 46 47 49;
#X obj 10 490 outlet;
