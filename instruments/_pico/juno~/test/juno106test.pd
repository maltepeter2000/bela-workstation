#N canvas 100 80 640 520 12;
#X text 20 14 juno106test - plays the Juno-106 measurement through midiout;
#X text 20 40 1) In Pd's MIDI settings choose the output that reaches the synth (e.g. IAC). 2) Start recording the synth. 3) Click start. Patches go out as Juno-106 SysEx \, notes on channel 1. Takes about 310 seconds. stop ends it., f 70;
#X msg 20 130 start;
#X msg 90 130 stop;
#X msg 20 170 read juno106test.txt \, rewind \, bang;
#X obj 20 210 qlist;
#X obj 300 130 r j106sx;
#X obj 300 160 t b a;
#X obj 300 190 until;
#X obj 360 190 list;
#X obj 300 220 list split 1;
#X obj 300 250 midiout;
#X obj 300 300 r j106note;
#X obj 300 330 t b a;
#X obj 300 360 until;
#X obj 360 360 list;
#X obj 300 390 list split 2;
#X obj 300 420 unpack f f;
#X obj 300 460 noteout 1;
#X obj 120 260 r j106done;
#X obj 120 290 print juno106test;
#X msg 90 170 stop;
#X msg 160 170 0 123;
#X obj 160 210 ctlout 1;
#X connect 2 0 4 0;
#X connect 4 0 5 0;
#X connect 3 0 21 0;
#X connect 3 0 22 0;
#X connect 21 0 5 0;
#X connect 22 0 23 0;
#X connect 6 0 7 0;
#X connect 7 1 9 1;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 10 1 9 1;
#X connect 10 2 8 1;
#X connect 12 0 13 0;
#X connect 13 1 15 1;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 16 1 15 1;
#X connect 16 2 14 1;
#X connect 17 0 18 0;
#X connect 17 1 18 1;
#X connect 19 0 20 0;
