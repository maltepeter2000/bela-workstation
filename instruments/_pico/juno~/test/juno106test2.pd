#N canvas 100 80 680 560 12;
#X text 20 14 juno106test2 - plays the Juno-106 measurement through midiout;
#X text 20 40 1) Pd MIDI output: the port that reaches the synth (e.g. IAC). 2) Pd audio input: the synth's output (e.g. BlackHole) - or record elsewhere and leave rec off. 3) Click start. Patches go out as Juno-106 SysEx \, notes on channel 1. About 293 seconds. With rec on \, juno106test2-rec.wav is written next to this patch., f 76;
#X msg 20 150 start;
#X msg 90 150 stop;
#X msg 20 190 read juno106test2.txt \, rewind \, bang;
#X obj 20 230 qlist;
#X obj 320 150 r j106sx;
#X obj 320 180 t b a;
#X obj 320 210 until;
#X obj 380 210 list;
#X obj 320 240 list split 1;
#X obj 320 270 midiout;
#X obj 320 320 r j106note;
#X obj 320 350 t b a;
#X obj 320 380 until;
#X obj 380 380 list;
#X obj 320 410 list split 2;
#X obj 320 440 unpack f f;
#X obj 320 480 noteout 1;
#X obj 120 280 r j106done;
#X obj 120 310 print juno106test2;
#X msg 90 190 stop;
#X msg 160 190 0 123;
#X obj 160 230 ctlout 1;
#X obj 20 370 tgl 19 0 empty empty rec 22 10 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 20 400 spigot;
#X msg 20 430 open -bytes 3 juno106test2-rec.wav \, start;
