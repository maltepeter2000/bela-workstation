#N canvas 0 50 820 460 10;
#X text 10 10 Juno on Bela: juno~ (Juno-60 engine \, Juno-106 patches) - MIDI in \, controller layer (junocc \, CC 20 on \, channel 1) \, pads (junopads \, channel 10) \, OLED \, OSC remote (UDP 7563). Files: juno~.pd_linux \, junocc.pd \, junopads.pd \, lkdisplay.pd \, junouser-bank.syx (the user bank \, made on the first save)., f 100;
#X obj 300 60 loadbang;
#X msg 300 90 channel 1 \, thru 0 \, sysexout 0;
#X obj 10 70 r juno;
#X obj 150 70 r juno-raw;
#X obj 10 130 juno~;
#X obj 10 180 dac~ 1 2;
#X obj 200 180 s juno-out;
#X obj 330 180 route float;
#X obj 330 240 midiout;
#X obj 420 210 lkdisplay;
#X text 420 240 midiout \, the first MIDI port (the Launchkey): its display (lkdisplay) \, SysEx (sysexout 1) and MIDI thru (thru 1), f 100;
#X obj 10 260 r juno-out;
#X obj 10 290 junocc 1;
#X obj 10 320 s juno;
#X obj 150 290 junopads 10;
#X obj 150 320 s juno;
#N canvas 0 50 900 420 midi 0;
#X text 10 10 MIDI from Bela -> raw bytes for juno~ (inlet 3). Bela passes MIDI to Pd parsed \, so it is put back together here. Channels of a second port (17-32) fold to 1-16. Notes on channel 10 belong to the pads., f 100;
#X obj 10 60 notein;
#X obj 10 90 pack f f f;
#X obj 10 120 expr if((\$f3 - 1) % 16 == 9 \, -1 \, 144 + (\$f3 - 1) % 16) \; \$f1 \; \$f2;
#X obj 10 150 pack f f f;
#X obj 10 180 route -1;
#X obj 330 60 ctlin;
#X obj 330 90 pack f f f;
#X obj 330 120 expr 176 + (\$f3 - 1) % 16 \; \$f2 \; \$f1;
#X obj 330 150 pack f f f;
#X obj 560 60 bendin;
#X obj 560 90 pack f f;
#X obj 560 120 expr 224 + (\$f2 - 1) % 16 \; \$f1 % 128 \; int(\$f1 / 128);
#X obj 560 150 pack f f f;
#X obj 10 240 pgmin;
#X obj 10 270 pack f f;
#X obj 10 300 expr 192 + (\$f2 - 1) % 16 \; \$f1 - 1;
#X obj 10 330 pack f f;
#X obj 330 240 touchin;
#X obj 330 270 pack f f;
#X obj 330 300 expr 208 + (\$f2 - 1) % 16 \; \$f1;
#X obj 330 330 pack f f;
#X obj 560 370 s juno-raw;
