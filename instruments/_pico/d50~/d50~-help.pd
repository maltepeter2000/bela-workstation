#X floatatom 160 3452 6 1 32 0 - - - 0;
#X msg 160 3476 reverbtype \$1;
#X text 82 3506 reverb (patch): reverb balance \, 0 is dry. \; reverbtype (patch): one of the 32 rooms \, halls \, delays and gates of the D-50. A change of type empties the reverb., f 64;
#X obj 60 3568 cnv 10 10 10 empty empty Chorus 24 6 0 14 #1e3791 #000000 0;
#X text 82 3596 The D-50 has one chorus per tone. These messages set both tones together., f 64;
