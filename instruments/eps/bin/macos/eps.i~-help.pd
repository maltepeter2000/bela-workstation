#X obj 60 12302 cnv 10 10 10 empty empty WS\ AMP 24 6 0 14 #1e3791 #000000 0;
#X text 82 12330 w_vol (WS volume) 0..127: volume of the wavesample \; w_pan (Pan) -128..127: pan (EPS-16 PLUS / ASR) \; w_boost (Boost) 0..1: +12 dB \; w_asrc (Amp mod) 0..15: amp modulation source \; w_aamt (Amp amt) -127..127: amp modulation amount \; w_pnsrc (Pan mod) 0..15: pan modulation source \; w_pnamt (Pan amt) -127..127: pan modulation amount \; w_bus (Out bus) 0..7: output bus as stored, f 64;
#X obj 60 12472 cnv 10 10 10 empty empty WS\ LFO 24 6 0 14 #1e3791 #000000 0;
