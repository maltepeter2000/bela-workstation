#N canvas 40 40 600 260 12;
#X text 10 10 Eingangsstufe I001 (clip~) -> NE570 Kompressor 2:1 rueckgekoppelt -> Output-Clip P11 (tanh);
#X text 10 30 (Detektor 64 Samples verzoegert  \, wie im Expander). Nennpegel: Mittelwert 0.2  \, Regelbereich +-30 dB;
#X obj 10 60 inlet~;
#X obj 600 60 r \$1-iclp;
#X obj 600 85 * -1;
#X obj 10 85 clip~ -1 1;
#X obj 200 60 delread~ \$0-env;
#X obj 330 230 loadbang;
#X obj 330 255 samplerate~;
#X obj 330 280 expr 64000/\$f1;
#X obj 10 100 expr~ \$v1*if(\$f3>0.5 \, min(0.2/max(\$v2 \, 0.0002) \, 31.6) \, 1);
#X obj 400 60 r \$1-cmpd;
#X obj 10 125 expr~ \$f2*tanh(\$v1/\$f2);
#X obj 600 110 r \$1-cclp;
#X obj 10 160 outlet~;
#X obj 200 140 abs~;
#X obj 200 170 lop~ 30;
#X obj 300 140 r \$1-cdet;
#X obj 200 200 delwrite~ \$0-env 20;
