#N canvas 40 40 600 300 12;
#X text 10 10 Tone-Netzwerk (22k/10n/47k): Shelf-Tiefpass  \, 0 = dunkel (1.45 kHz);
#X obj 10 40 inlet~;
#X obj 10 80 lop~ 1000;
#X obj 10 110 *~ 0;
#X obj 120 110 *~ 0;
#X obj 10 140 +~;
#X obj 10 170 outlet~;
#X obj 220 40 r \$1-tone;
#X obj 220 70 expr 1/(6.2831853*(\$f1*47000+11000)*1e-08) \; \$f1*47000/(\$f1*47000+11000);
#X obj 220 100 t f f;
#X obj 300 130 expr 1-\$f1;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 1 0 4 0;
#X connect 3 0 5 0;
#X connect 4 0 5 1;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 2 1;
#X connect 8 1 9 0;
#X connect 9 0 4 1;
#X connect 9 1 10 0;
#X connect 10 0 3 1;
