#N canvas 40 40 700 360 12;
#X text 10 10 3 x Sallen-Key-Tiefpass (Anti-Aliasing oder Rekonstruktion). \$2 = aa oder rk;
#X text 10 30 fc-Faktor und Guete-Mischung: 0 = Butterworth 7.5 kHz  \; 1 = Schaltplan-Lesung;
#X obj 10 60 inlet~;
#X obj 200 60 r \$1-\$2-fc;
#X obj 330 60 r \$1-\$2-q;
#X obj 200 90 t b f;
#X obj 330 90 t b f;
#X obj 200 120 pack 0 f f;
#X obj 200 150 expr \$f2*(7500+\$f3*(8000-7500)) \; 0.5176+\$f3*(0.83-0.5176) \; \$f2*(7500+\$f3*(7500-7500)) \; 0.7071+\$f3*(1.31-0.7071) \; \$f2*(7500+\$f3*(7000-7500)) \; 1.9319+\$f3*(3.43-1.9319);
#X obj 200 180 pack f f;
#X obj 310 180 pack f f;
#X obj 420 180 pack f f;
#X obj 10 220 vrs-lp2;
#X obj 10 250 vrs-lp2;
#X obj 10 280 vrs-lp2;
#X obj 10 320 outlet~;
#X connect 3 0 5 0;
#X connect 4 0 6 0;
#X connect 5 1 7 1;
#X connect 5 0 7 0;
#X connect 6 1 7 2;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 1 9 1;
#X connect 9 0 12 1;
#X connect 8 2 10 0;
#X connect 8 3 10 1;
#X connect 10 0 13 1;
#X connect 8 4 11 0;
#X connect 8 5 11 1;
#X connect 11 0 14 1;
#X connect 2 0 12 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 14 0 15 0;
