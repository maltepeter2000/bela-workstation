#N canvas 40 40 700 300 12;
#X text 10 10 BBD-Reihe  \, Schreibseite: Taktartefakte  \, Saettigung  \, Speicher. \$2 = o oder u;
#X text 10 30 Eingaenge: Audio  \, f_clk  \, Taktzaehler cos  \, Taktzaehler sin (von vrs-bbdr);
#X obj 10 60 inlet~;
#X obj 200 60 inlet~;
#X obj 330 60 inlet~;
#X obj 450 60 inlet~;
#X obj 10 90 vrs-sh \$1;
#X obj 10 120 expr~ (tanh((\$v1+\$f3)*\$f2)-tanh(\$f3*\$f2))/\$f2;
#X obj 300 90 r \$1-bias;
#X obj 200 90 r \$1-drv;
#X obj 10 150 delwrite~ \$1-bbd-\$2 1000;
#X obj 330 150 delwrite~ \$1-tc-\$2 1000;
#X obj 450 180 delwrite~ \$1-ts-\$2 1000;
#X obj 200 210 delwrite~ \$1-tf-\$2 1000;
