#N canvas 40 40 640 260 12;
#X text 10 10 NE570 Expander 1:2  \, Detektor sieht das verzoegerte Signal mit Rauschen.;
#X text 10 30 Detektor ueber delwrite~/delread~ um 64 Samples verzoegert  \, genau wie im Kompressor.;
#X text 10 50 Ohne diese Symmetrie gewinnt die Regenerationsschleife Energie.;
#X obj 10 80 inlet~;
#X obj 200 80 abs~;
#X obj 200 110 lop~ 30;
#X obj 300 80 r \$1-cdet;
#X obj 200 140 delwrite~ \$0-env 20;
#X obj 200 170 delread~ \$0-env;
#X obj 350 110 loadbang;
#X obj 350 135 samplerate~;
#X obj 350 160 expr 64000/\$f1;
#X obj 10 210 expr~ \$v1*if(\$f3>0.5 \, min(max(\$v2/0.2 \, 0.0316) \, 31.6)*\$f4 \, 1);
#X obj 420 170 r \$1-cmpd;
#X obj 520 170 r \$1-trck;
#X obj 10 250 outlet~;
#X connect 3 0 12 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 6 0 5 1;
#X connect 5 0 7 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 8 0;
#X connect 8 0 12 1;
#X connect 13 0 12 2;
#X connect 14 0 12 3;
#X connect 12 0 15 0;
