#N canvas 40 40 900 420 12;
#X text 10 10 Abgriff nach \$3 Chips: Verzoegerung = Zeit fuer \$3 x 768 Takte (wie in der echten Eimerkette);
#X text 10 30 Aendert sich der Takt  \, laeuft der ganze Pufferinhalt schneller oder langsamer heraus (Tonhoehe aendert sich);
#X obj 10 60 inlet~;
#X obj 250 60 inlet~;
#X obj 400 60 inlet~;
#X obj 10 90 expr~ min(( \$3 * 768 )*1000/max(\$v1 \, 1000) \, 990);
#X obj 250 130 delread4~ \$1-tc-\$2;
#X obj 400 130 delread4~ \$1-ts-\$2;
#X obj 550 130 delread4~ \$1-tf-\$2;
#X obj 10 170 expr~ max(min(\$v6+(( \$3 * 768 )-atan2(\$v2*\$v3-\$v1*\$v4 \, \$v1*\$v3+\$v2*\$v4)*65536/6.2831853)*1000/max(\$v5 \, 1000) \, 990) \, 0);
#X obj 250 220 delread4~ \$1-tc-\$2;
#X obj 400 220 delread4~ \$1-ts-\$2;
#X obj 550 220 delread4~ \$1-tf-\$2;
#X obj 10 260 expr~ max(min(\$v6+(( \$3 * 768 )-atan2(\$v2*\$v3-\$v1*\$v4 \, \$v1*\$v3+\$v2*\$v4)*65536/6.2831853)*1000/max(\$v5 \, 1000) \, 990) \, 0);
#X obj 250 310 delread4~ \$1-tc-\$2;
#X obj 400 310 delread4~ \$1-ts-\$2;
#X obj 550 310 delread4~ \$1-tf-\$2;
#X obj 10 350 expr~ max(min(\$v6+(( \$3 * 768 )-atan2(\$v2*\$v3-\$v1*\$v4 \, \$v1*\$v3+\$v2*\$v4)*65536/6.2831853)*1000/max(\$v5 \, 1000) \, 990) \, 0);
#X obj 10 420 delread4~ \$1-bbd-\$2;
#X obj 10 450 outlet~;
