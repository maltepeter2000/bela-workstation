#N canvas 40 40 900 420 12;
#X text 10 10 Takte: obere Reihe (VCO 80 207) und untere Reihe (Echo synchron  \, Reverb VCO 80 205);
#X obj 10 40 r \$1-mode;
#X obj 100 40 r \$1-key;
#X obj 190 40 r \$1-fine;
#X obj 280 40 r \$1-rclk;
#X obj 370 40 r \$1-rnge;
#X obj 10 70 t b f;
#X obj 100 70 t b f;
#X obj 190 70 t b f;
#X obj 280 70 t b f;
#X obj 370 70 t b f;
#X obj 10 100 pack 0 f f f f f;
#X obj 10 130 expr 19000*pow(\$f6 \, \$f4)*if(\$f2<0.5 \, if(\$f3<1.5 \, 1.6184 \, 1) \, if(\$f5>0.5 \, 1.6184 \, 1)) \; if(\$f2<0.5 \, 19000*pow(\$f6 \, \$f4)*if(\$f2<0.5 \, if(\$f3<1.5 \, 1.6184 \, 1) \, if(\$f5>0.5 \, 1.6184 \, 1)) \, 30750*pow(\$f6 \, \$f4));
#X msg 10 160 \$1 50;
#X msg 200 160 \$1 50;
#X obj 10 190 line~;
#X obj 200 190 line~;
#X text 500 40 Sweep-LFO (Dreieck);
#X obj 500 70 r \$1-swp;
#X obj 500 100 phasor~;
#X obj 500 130 expr~ abs(\$v1*2-1)*2-1;
#X obj 650 70 r \$1-dpth;
#X obj 750 70 r \$1-lfom;
#X obj 650 100 t b f;
#X obj 750 100 t b f;
#X obj 650 130 pack 0 f f;
#X obj 650 160 expr \$f2*\$f3;
