#X symbolatom 100 3078 20 0 0 0 - - - 0;
#X obj 260 3050 unpack s f s;
#X floatatom 260 3078 4 0 0 0 - - - 0;
#X symbolatom 300 3078 20 0 0 0 - - - 0;
#X text 82 3106 preset selects a factory tone \, user a slot of the user bank. They go to the tone chosen with edit: A \, or B of a split or mix. The third outlet answers with tonea or toneb \, the bank \, the number and the name. \; store 5 followed by userwrite keeps the edited tone in user slot 5 and on disk. The editor does both with save tone. \; op recalls an operation slot: key mode \, split point \, tone B and the rest of the OPERATION rows. Tone B is loaded from its bank and number., f 64;
#X obj 60 3264 cnv 10 10 10 empty empty Line\ and\ wave 24 6 0 14 #1e3791 #000000 0;
#X text 82 3292 Values of the selected line (line) of the edited tone (edit)., f 64;
#X obj 460 3336 s \$0-cz4;
#X floatatom 60 3312 6 0 1 0 - - - 0;
#X msg 60 3336 line \$1;
#X floatatom 160 3312 6 0 3 0 - - - 0;
#X msg 160 3336 linesel \$1;
#X floatatom 260 3312 6 0 7 0 - - - 0;
#X msg 260 3336 wave \$1;
#X floatatom 360 3312 6 0 8 0 - - - 0;
#X msg 360 3336 wave2 \$1;
#X text 82 3366 line (0): the line that the line and envelope controls edit. Values: 0 1 \, 1 2. \; linesel (tone): line 1 \, line 2 \, line 1 twice (line 2 detuned) \, both lines. Values: 0 1 \, 1 2 \, 2 1+1' \, 3 1+2'. \; wave (tone): first wave of the line. Values: 0 saw \, 1 square \, 2 pulse \, 3 null \, 4 dsine \, 5 sawpuls \, 6 reso \, 7 pulse2. \; wave2 (tone): second wave: the line alternates the two every cycle. Values: 0 off \, 1 saw \, 2 square \, 3 pulse \, 4 null \, 5 dsine \, 6 sawpuls \, 7 reso \, 8 pulse2., f 64;
#X obj 460 3538 s \$0-cz4;
#X floatatom 60 3514 6 0 7 0 - - - 0;
#X msg 60 3538 window \$1;
#X floatatom 160 3514 6 0 2 0 - - - 0;
#X msg 160 3538 ringmod \$1;
#X floatatom 260 3514 6 -1 1 0 - - - 0;
#X msg 260 3538 octave \$1;
#X floatatom 360 3514 6 1 15 0 - - - 0;
#X msg 360 3538 level \$1;
#X text 82 3568 window (tone): window of the resonance waves (CZ waves 6 \, 7 \, 8 = saw \, tri \, trap). Values: 0 off \, 1 saw \, 2 tri \, 3 trap \, 4 pulse \, 5 dsaw \, 6 dsaw6 \, 7 dsaw7. \; ringmod (tone): line 2 ring-modulated by line 1 \, or its pitch by noise (1+1' and 1+2'). Values: 0 off \, 1 ring \, 2 noise. \; octave (tone): octave of the tone. Values: -1 -1 \, 0 0 \, 1 +1. \; level (tone): level of the line (CZ-1)., f 64;
#X obj 60 3694 cnv 10 10 10 empty empty Detune\ and\ vibrato 24 6 0 14 #1e3791 #000000 0;
