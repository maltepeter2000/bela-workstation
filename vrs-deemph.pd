#N canvas 40 40 600 260 12;
#X text 10 10 De-Emphasis (I009: 470k / 470k+470p): Shelf -6 dB zwischen 360 und 720 Hz;
#X obj 10 40 inlet~;
#X obj 10 70 lop~ 360;
#X obj 10 100 *~ 0;
#X obj 120 100 *~ 0;
#X obj 10 130 +~;
#X obj 10 160 outlet~;
#X obj 250 40 r \$1-emph;
#X obj 250 70 expr 0.5*\$f1 \; 1-0.5*\$f1;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 1 0 4 0;
#X connect 3 0 5 0;
#X connect 4 0 5 1;
#X connect 5 0 6 0;
#X connect 7 0 8 0;
#X connect 8 0 3 1;
#X connect 8 1 4 1;
